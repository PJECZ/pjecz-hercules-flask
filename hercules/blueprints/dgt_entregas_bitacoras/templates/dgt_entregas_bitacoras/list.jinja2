{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {% if current_user.can_view('DGT ENTREGAS') %}
            {{ topbar.button('Entregas', url_for('dgt_entregas.list_active'), 'mdi:import') }}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call list.card() %}
        <!-- Filtros DGT Entregas Bitácoras -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtrosDgtEntregasBitacoras.buscar(); return false;">
                    <div class="col-4">
                        <div class="form-floating">
                            <input id="filtroDgtEntregaBitacoraEvento" type="text" class="form-control" aria-label="Evento" style="text-transform: uppercase;">
                            <label for="filtroDgtEntregaBitacoraEvento">Evento</label>
                        </div>
                    </div>
                    <div class="col-4 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtrosDgtEntregasBitacoras.buscar(); return false;" id="button-buscar"><span class="mdi:magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtrosDgtEntregasBitacoras.limpiar();" id="button-limpiar"><span class="mdi:broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- Datatable DGT Entregas Bitácoras -->
        <table id="dgt_entregas_bitacoras_datatable" class="table {% if estatus == 'B'%}table-dark{% endif %} display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>Evento</th>
                    <th>Tamaño</th>
                    <th>Archivo actualizado</th>
                    <th>Creado</th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <script src="/static/js/datatables-constructor.js"></script>
    <script src="/static/js/datatables-filtros.js"></script>
    <script>
        // DataTable DGT Entregas Bitácoras
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDTDgtEntregasBitacoras = constructorDataTable.config();
        configDTDgtEntregasBitacoras['ajax']['url'] = "{{ url_for('dgt_entregas_bitacoras.datatable_json') }}";
        configDTDgtEntregasBitacoras['ajax']['data'] = {{ filtros }};
        configDTDgtEntregasBitacoras['columns'] = [
            { data: 'detalle' },
            { data: 'archivo_tamano' },
            { data: 'archivo_actualizado' },
            { data: 'creado' }
        ];
        configDTDgtEntregasBitacoras['columnDefs'] = [
            {
                targets: 0, // detalle
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + data.evento + '</a>';
                }
            }
        ];
        // Filtros DGT Entregas Bitácoras
        const filtrosDgtEntregasBitacoras = new FiltrosDataTable('#dgt_entregas_bitacoras_datatable', configDTDgtEntregasBitacoras);
        filtrosDgtEntregasBitacoras.agregarInput('filtroDgtEntregaBitacoraEvento', 'evento');
        filtrosDgtEntregasBitacoras.precargar();
    </script>
{% endblock %}
