{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {% if current_user.can_view('DGT PLATAFORMAS') %}
            {{ topbar.button('Plataformas', url_for('dgt_plataformas.list_active'), 'mdi:ship-wheel') }}
        {% endif %}
        {% if current_user.can_admin('DGT PLATAFORMAS AUTORIDADES') %}
            {% if estatus == 'A' %}{{ topbar.button_list_inactive('Inactivos', url_for('dgt_plataformas_autoridades.list_inactive')) }}{% endif %}
            {% if estatus == 'B' %}{{ topbar.button_list_active('Activos', url_for('dgt_plataformas_autoridades.list_active')) }}{% endif %}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call list.card() %}
        <!-- Filtros DGT Plataformas Autoridades -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtrosDgtPlataformasAutoridades.buscar(); return false;">
                    <div class="col-3">
                        <div class="form-floating">
                            <input id="filtroAutoridadClave" type="text" class="form-control" aria-label="Autoridad clave" style="text-transform: uppercase;">
                            <label for="filtroAutoridadClave">Autoridad clave</label>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="form-floating">
                            <input id="filtroAutoridadDescripcion" type="text" class="form-control" aria-label="Autoridad descripción" style="text-transform: uppercase;">
                            <label for="filtroAutoridadDescripcion">Autoridad descripción</label>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="form-floating">
                            <input id="filtroDgtPlataformaDescripcion" type="text" class="form-control" aria-label="Plataforma" style="text-transform: uppercase;">
                            <label for="filtroDgtPlataformaDescripcion">Plataforma</label>
                        </div>
                    </div>
                    <div class="col-3 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtrosDgtPlataformasAutoridades.buscar(); return false;" id="button-buscar"><span class="mdi:magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtrosDgtPlataformasAutoridades.limpiar();" id="button-limpiar"><span class="mdi:broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- Datatable DGT Plataformas Autoridades -->
        <table id="dgt_plataformas_autoridades_datatable" class="table {% if estatus == 'B'%}table-dark{% endif %} display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>Autoridad clave</th>
                    <th>Autoridad descripción</th>
                    <th>Distrito</th>
                    <th>Plataforma</th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <script src="/static/js/datatables-constructor.js"></script>
    <script src="/static/js/datatables-filtros.js"></script>
    <script>
        // DataTable DGT Plataformas Autoridades
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDTDgtPlataformasAutoridades = constructorDataTable.config();
        configDTDgtPlataformasAutoridades['ajax']['url'] = "{{ url_for('dgt_plataformas_autoridades.datatable_json') }}";
        configDTDgtPlataformasAutoridades['ajax']['data'] = {{ filtros }};
        configDTDgtPlataformasAutoridades['columns'] = [
            { data: 'detalle' },
            { data: 'autoridad_descripcion_corta' },
            { data: 'distrito_nombre_corto' },
            { data: 'dgt_plataforma_descripcion' }
        ];
        configDTDgtPlataformasAutoridades['columnDefs'] = [
            {
                targets: 0, // detalle
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + data.autoridad_clave + '</a>';
                }
            }
        ];
        // Filtros DGT Plataformas Autoridades
        const filtrosDgtPlataformasAutoridades = new FiltrosDataTable('#dgt_plataformas_autoridades_datatable', configDTDgtPlataformasAutoridades);
        filtrosDgtPlataformasAutoridades.agregarInput('filtroAutoridadClave', 'autoridad_clave');
        filtrosDgtPlataformasAutoridades.agregarInput('filtroAutoridadDescripcion', 'autoridad_descripcion');
        filtrosDgtPlataformasAutoridades.agregarInput('filtroDgtPlataformaDescripcion', 'dgt_plataforma_descripcion');
        filtrosDgtPlataformasAutoridades.precargar();
    </script>
{% endblock %}
