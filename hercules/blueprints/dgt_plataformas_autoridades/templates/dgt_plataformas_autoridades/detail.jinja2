{% extends 'layouts/app.jinja2' %}
{% import 'macros/detail.jinja2' as detail %}
{% import 'macros/modals.jinja2' as modals %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}DGT Plataforma Autoridad {{ dgt_plataforma_autoridad.autoridad.clave }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons('DGT Plataforma Autoridad ' + dgt_plataforma_autoridad.autoridad.clave) %}
        {% if current_user.can_view('DGT PLATAFORMAS') %}
            {{ topbar.button_previous('DGT Plataforma', url_for('dgt_plataformas.detail', dgt_plataforma_id=dgt_plataforma_autoridad.dgt_plataforma_id)) }}
        {% else %}
            {{ topbar.button_previous('DGT Plataformas Autoridades', url_for('dgt_plataformas_autoridades.list_active')) }}
        {% endif %}
        {% if current_user.can_admin('DGT PLATAFORMAS AUTORIDADES') %}
            {% if dgt_plataforma_autoridad.estatus == 'A' %}{{ topbar.button_delete('Eliminar', url_for('dgt_plataformas_autoridades.delete', dgt_plataforma_autoridad_id=dgt_plataforma_autoridad.id)) }}{% endif %}
            {% if dgt_plataforma_autoridad.estatus == 'B' %}{{ topbar.button_recover('Recuperar', url_for('dgt_plataformas_autoridades.recover', dgt_plataforma_autoridad_id=dgt_plataforma_autoridad.id)) }}{% endif %}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call detail.card(estatus=dgt_plataforma_autoridad.estatus) %}
        <div class="row">
            {{ detail.label_value_big('Autoridad', dgt_plataforma_autoridad.autoridad.clave) }}
            {% if current_user.can_view('AUTORIDADES') %}
                {{ detail.label_value('Descripción', dgt_plataforma_autoridad.autoridad.descripcion_corta, url_for('autoridades.detail', autoridad_id=dgt_plataforma_autoridad.autoridad_id)) }}
            {% else %}
                {{ detail.label_value('Descripción', dgt_plataforma_autoridad.autoridad.descripcion_corta) }}
            {% endif %}
            {{ detail.label_value('Distrito', dgt_plataforma_autoridad.autoridad.distrito.nombre_corto) }}
            {% if current_user.can_view('DGT PLATAFORMAS') %}
                {{ detail.label_value('Plataforma', dgt_plataforma_autoridad.dgt_plataforma.descripcion, url_for('dgt_plataformas.detail', dgt_plataforma_id=dgt_plataforma_autoridad.dgt_plataforma_id)) }}
            {% else %}
                {{ detail.label_value('Plataforma', dgt_plataforma_autoridad.dgt_plataforma.descripcion) }}
            {% endif %}
            {{ detail.label_value('Modificado', moment(dgt_plataforma_autoridad.modificado, local=False).format('DD MMM YYYY HH:mm')) }}
        </div>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    {% if current_user.can_admin('DGT PLATAFORMAS AUTORIDADES') %}
        {% if dgt_plataforma_autoridad.estatus == 'A' %}{{ modals.custom_javascript_delete('Eliminar', '¿Quitar la autoridad ' + dgt_plataforma_autoridad.autoridad.clave + ' de la plataforma?') }}{% endif %}
        {% if dgt_plataforma_autoridad.estatus == 'B' %}{{ modals.custom_javascript_recover('Recuperar', '¿Volver a asignar la autoridad ' + dgt_plataforma_autoridad.autoridad.clave + ' a la plataforma?') }}{% endif %}
    {% endif %}
{% endblock %}
