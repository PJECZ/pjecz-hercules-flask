{% extends 'layouts/app.jinja2' %}
{% import 'macros/detail.jinja2' as detail %}
{% import 'macros/modals.jinja2' as modals %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}DGT Tipo {{ dgt_tipo.clave }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons('DGT Tipo ' + dgt_tipo.clave) %}
        {{ topbar.button_previous('DGT Tipos', url_for('dgt_tipos.list_active')) }}
        {% if current_user.can_edit('DGT TIPOS') %}
            {{ topbar.button_edit('Editar', url_for('dgt_tipos.edit', dgt_tipo_id=dgt_tipo.id)) }}
        {% endif %}
        {% if current_user.can_admin('DGT TIPOS') %}
            {% if dgt_tipo.estatus == 'A' %}{{ topbar.button_delete('Eliminar', url_for('dgt_tipos.delete', dgt_tipo_id=dgt_tipo.id)) }}{% endif %}
            {% if dgt_tipo.estatus == 'B' %}{{ topbar.button_recover('Recuperar', url_for('dgt_tipos.recover', dgt_tipo_id=dgt_tipo.id)) }}{% endif %}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call detail.card(estatus=dgt_tipo.estatus) %}
        <div class="row">
            {{ detail.label_value_big('Clave', dgt_tipo.clave) }}
            {{ detail.label_value('Descripción', dgt_tipo.descripcion) }}
        </div>
    {% endcall %}
    {% if current_user.can_view('DGT RUTAS') and dgt_tipo.estatus == 'A' %}
        {% call detail.card('Rutas') %}
            <!-- Filtros DGT Rutas -->
            <div class="row">
                <div class="col">
                    <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtrosDTDgtRutas.buscar(); return false;">
                        <div class="col-4">
                            <div class="form-floating">
                                <input id="filtroClave" type="text" class="form-control" aria-label="Clave" style="text-transform: uppercase;">
                                <label for="filtroClave">Clave</label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-floating">
                                <input id="filtroAutoridadClave" type="text" class="form-control" aria-label="Autoridad clave" style="text-transform: uppercase;">
                                <label for="filtroAutoridadClave">Autoridad clave</label>
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtrosDTDgtRutas.buscar(); return false;" id="button-buscar"><span class="mdi:magnify"></span></button>
                            <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtrosDTDgtRutas.limpiar();" id="button-limpiar"><span class="mdi:broom"></span></button>
                        </div>
                    </form>
                </div>
            </div>
            <!-- Datatable DGT Rutas -->
            <table id="dgt_rutas_datatable" class="table display nowrap" style="width:100%">
                <thead>
                    <tr>
                        <th>Clave</th>
                        <th>Depósito</th>
                        <th>Autoridad clave</th>
                        <th>Directorio</th>
                    </tr>
                </thead>
            </table>
        {% endcall %}
    {% endif %}
{% endblock %}

{% block custom_javascript %}
    {% if current_user.can_admin('DGT TIPOS') %}
        {% if dgt_tipo.estatus == 'A' %}{{ modals.custom_javascript_delete('Eliminar', '¿Eliminar DGT Tipo ' + dgt_tipo.clave + '?') }}{% endif %}
        {% if dgt_tipo.estatus == 'B' %}{{ modals.custom_javascript_recover('Recuperar', '¿Recuperar DGT Tipo ' + dgt_tipo.clave + '?') }}{% endif %}
    {% endif %}
    {% if current_user.can_view('DGT RUTAS') and dgt_tipo.estatus == 'A' %}
        <script src="/static/js/datatables-constructor.js"></script>
        <script src="/static/js/datatables-filtros.js"></script>
        <script>
            // DataTable DGT Rutas
            const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
            let configDTDgtRutas = constructorDataTable.config();
            configDTDgtRutas['ajax']['url'] = "{{ url_for('dgt_rutas.datatable_json') }}";
            configDTDgtRutas['ajax']['data'] = { 'estatus': "A", 'dgt_tipo_id': "{{ dgt_tipo.id }}" };
            configDTDgtRutas['columns'] = [
                { data: "detalle" },
                { data: "dgt_deposito_clave" },
                { data: "autoridad_clave" },
                { data: "directorio" }
            ];
            configDTDgtRutas['columnDefs'] = [
                {
                    targets: 0, // detalle
                    data: null,
                    render: function(data, type, row, meta) {
                        return '<a href="' + data.url + '">' + data.clave + '</a>';
                    }
                }
            ];
            // Filtros DGT Rutas
            const filtrosDTDgtRutas = new FiltrosDataTable('#dgt_rutas_datatable', configDTDgtRutas);
            filtrosDTDgtRutas.agregarInput('filtroClave', 'clave');
            filtrosDTDgtRutas.agregarInput('filtroAutoridadClave', 'autoridad_clave');
            filtrosDTDgtRutas.precargar();
        </script>
    {% endif %}
{% endblock %}
