{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {% if current_user.can_view('DGT DEPOSITOS') %}
            {{ topbar.button('Depósitos', url_for('dgt_depositos.list_active'), 'mdi:package') }}
        {% endif %}
        {% if current_user.can_view('DGT RUTAS') %}
            {{ topbar.button('Rutas', url_for('dgt_rutas.list_active'), 'mdi:source-branch') }}
        {% endif %}
        {% if current_user.can_admin('DGT TIPOS') %}
            {% if estatus == 'A' %}{{ topbar.button_list_inactive('Inactivos', url_for('dgt_tipos.list_inactive')) }}{% endif %}
            {% if estatus == 'B' %}{{ topbar.button_list_active('Activos', url_for('dgt_tipos.list_active')) }}{% endif %}
        {% endif %}
        {% if current_user.can_insert('DGT TIPOS') %}
            {{ topbar.button_new('Nuevo DGT Tipo', url_for('dgt_tipos.new')) }}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call list.card() %}
        <!-- Filtros DGT Tipos -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtrosDgtTipos.buscar(); return false;">
                    <div class="col-2">
                        <div class="form-floating">
                            <input id="filtroDgtTipoClave" type="text" class="form-control" aria-label="Clave" style="text-transform: uppercase;">
                            <label for="filtroDgtTipoClave">Clave</label>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-floating">
                            <input id="filtroDgtTipoDescripcion" type="text" class="form-control" aria-label="Descripción" style="text-transform: uppercase;">
                            <label for="filtroDgtTipoDescripcion">Descripción</label>
                        </div>
                    </div>
                    <div class="col-6 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtrosDgtTipos.buscar(); return false;" id="button-buscar"><span class="mdi:magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtrosDgtTipos.limpiar();" id="button-limpiar"><span class="mdi:broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- Datatable DGT Tipos -->
        <table id="dgt_tipos_datatable" class="table {% if estatus == 'B'%}table-dark{% endif %} display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>Clave</th>
                    <th>Descripción</th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <script src="/static/js/datatables-constructor.js"></script>
    <script src="/static/js/datatables-filtros.js"></script>
    <script>
        // DataTable DGT Tipos
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDTDgtTipos = constructorDataTable.config();
        configDTDgtTipos['ajax']['url'] = "{{ url_for('dgt_tipos.datatable_json') }}";
        configDTDgtTipos['ajax']['data'] = {{ filtros }};
        configDTDgtTipos['columns'] = [
            { data: 'detalle' },
            { data: 'descripcion' }
        ];
        configDTDgtTipos['columnDefs'] = [
            {
                targets: 0, // detalle
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + data.clave + '</a>';
                }
            }
        ];
        // Filtros DGT Tipos
        const filtrosDgtTipos = new FiltrosDataTable('#dgt_tipos_datatable', configDTDgtTipos);
        filtrosDgtTipos.agregarInput('filtroDgtTipoClave', 'clave');
        filtrosDgtTipos.agregarInput('filtroDgtTipoDescripcion', 'descripcion');
        filtrosDgtTipos.precargar();
    </script>
{% endblock %}
